
# ============================================================
# Project : Northstar Technologies
# Script  : Test-EmployeeDatabase.ps1
# Purpose : Validate the fictional employee CSV database
# Version : 1.0.0
# ============================================================

[CmdletBinding()]
param(
    [string]$CsvPath = (Join-Path $PSScriptRoot "..\data\employees.csv")
)

$ErrorActionPreference = "Stop"

Write-Host "`nNORTHSTAR TECHNOLOGIES" -ForegroundColor Cyan
Write-Host "EMPLOYEE DATABASE VALIDATION" -ForegroundColor Cyan
Write-Host "========================================"

$errors = @()
$warnings = @()

# Required CSV columns
$requiredColumns = @(
    "EmployeeID",
    "FirstName",
    "LastName",
    "Username",
    "Email",
    "Department",
    "JobTitle",
    "Manager",
    "Location",
    "EmploymentType",
    "HireDate",
    "AccountStatus"
)

$allowedDepartments = @(
    "Human Resources",
    "Finance",
    "Information Technology",
    "Sales",
    "Management"
)

# Check CSV existence
if (-not (Test-Path -LiteralPath $CsvPath -PathType Leaf)) {
    Write-Host "ERROR: Employee CSV file not found." -ForegroundColor Red
    exit 1
}

# Import employee records
try {
    $employees = @(Import-Csv -LiteralPath $CsvPath)

    if ($employees.Count -eq 0) {
        throw "Employee database contains no records."
    }
}
catch {
    Write-Host "ERROR: Unable to import CSV." -ForegroundColor Red
    Write-Host $_.Exception.Message
    exit 1
}

Write-Host "`nSTEP 1: COLUMN VALIDATION" -ForegroundColor Yellow

$actualColumns = @($employees[0].PSObject.Properties.Name)

foreach ($column in $requiredColumns) {
    if ($column -notin $actualColumns) {
        $errors += "Missing required column: $column"
    }
}

if ($errors.Count -eq 0) {
    Write-Host "PASS: All required columns exist." -ForegroundColor Green
}

if ($errors.Count -gt 0) {
    $errors | ForEach-Object {
        Write-Host "FAIL: $_" -ForegroundColor Red
    }
    exit 1
}

Write-Host "`nSTEP 2: REQUIRED FIELD VALIDATION" -ForegroundColor Yellow

$requiredFields = @(
    "EmployeeID",
    "FirstName",
    "LastName",
    "Username",
    "Email",
    "Department",
    "JobTitle",
    "Location",
    "EmploymentType",
    "HireDate",
    "AccountStatus"
)

foreach ($employee in $employees) {
    foreach ($field in $requiredFields) {
        if ([string]::IsNullOrWhiteSpace([string]$employee.$field)) {
            $errors += "$($employee.EmployeeID): Missing $field"
        }
    }
}

Write-Host "`nSTEP 3: DUPLICATE VALIDATION" -ForegroundColor Yellow

foreach ($field in @("EmployeeID", "Username", "Email")) {
    $duplicates = $employees |
        Group-Object { ([string]$_.$field).Trim().ToLowerInvariant() } |
        Where-Object { $_.Count -gt 1 }

    foreach ($duplicate in $duplicates) {
        $errors += "Duplicate $field value: $($duplicate.Name)"
    }
}

Write-Host "`nSTEP 4: DEPARTMENT VALIDATION" -ForegroundColor Yellow

foreach ($employee in $employees) {
    if ($employee.Department -notin $allowedDepartments) {
        $errors += "$($employee.EmployeeID): Invalid department."
    }
}

Write-Host "`nSTEP 5: EMAIL VALIDATION" -ForegroundColor Yellow

foreach ($employee in $employees) {
    if ($employee.Email -notmatch '^[^@\s]+@northstar\.example$') {
        $errors += "$($employee.EmployeeID): Invalid fictional company email."
    }
}

Write-Host "`nSTEP 6: EMPLOYMENT DATA VALIDATION" -ForegroundColor Yellow

foreach ($employee in $employees) {

    if ($employee.EmploymentType -notin @("FullTime", "PartTime")) {
        $errors += "$($employee.EmployeeID): Invalid employment type."
    }

    if ($employee.AccountStatus -notin @("Enabled", "Disabled")) {
        $errors += "$($employee.EmployeeID): Invalid account status."
    }

    $parsedDate = [datetime]::MinValue

    $validDate = [datetime]::TryParseExact(
        [string]$employee.HireDate,
        "yyyy-MM-dd",
        [Globalization.CultureInfo]::InvariantCulture,
        [Globalization.DateTimeStyles]::None,
        [ref]$parsedDate
    )

    if (-not $validDate) {
        $errors += "$($employee.EmployeeID): Invalid hire date format."
    }
}

Write-Host "`nSTEP 7: MANAGER REFERENCE VALIDATION" -ForegroundColor Yellow

$validUsernames = @(
    $employees | ForEach-Object { $_.Username.ToLowerInvariant() }
)

foreach ($employee in $employees) {
    if (-not [string]::IsNullOrWhiteSpace($employee.Manager)) {
        if ($employee.Manager.ToLowerInvariant() -notin $validUsernames) {
            $errors += "$($employee.EmployeeID): Manager not found."
        }
    }
}

Write-Host "`nSTEP 8: EMPLOYEE COUNT VALIDATION" -ForegroundColor Yellow

if ($employees.Count -ne 50) {
    $warnings += "Expected 50 employees; found $($employees.Count)."
}
else {
    Write-Host "PASS: Exactly 50 employee records found." -ForegroundColor Green
}

# Department distribution
Write-Host "`nDEPARTMENT DISTRIBUTION" -ForegroundColor Cyan

$employees |
    Group-Object Department |
    Select-Object Name, Count |
    Format-Table -AutoSize

# Final validation summary
Write-Host "`n========================================"
Write-Host "VALIDATION SUMMARY" -ForegroundColor Cyan
Write-Host "========================================"

Write-Host "Total Employees : $($employees.Count)"
Write-Host "Total Errors    : $($errors.Count)"
Write-Host "Total Warnings  : $($warnings.Count)"

if ($errors.Count -gt 0) {
    Write-Host "`nVALIDATION ERRORS:" -ForegroundColor Red

    $errors | ForEach-Object {
        Write-Host "- $_" -ForegroundColor Red
    }
}

if ($warnings.Count -gt 0) {
    Write-Host "`nVALIDATION WARNINGS:" -ForegroundColor Yellow

    $warnings | ForEach-Object {
        Write-Host "- $_" -ForegroundColor Yellow
    }
}

if ($errors.Count -eq 0) {
    Write-Host "`nRESULT: VALIDATION PASSED" -ForegroundColor Green
}
else {
    Write-Host "`nRESULT: VALIDATION FAILED" -ForegroundColor Red
    exit 1
}
